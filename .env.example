# LLM Provider settings: 'offline' (builtin engine), 'ollama' (local Ollama server), or 'openai'
LLM_PROVIDER=offline

# Ollama local configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional OpenAI configuration (if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application Settings
APP_NAME=Natural Language Action Agent
DEBUG=true
